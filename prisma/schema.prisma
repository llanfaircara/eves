// EVES Property Management - Prisma Schema
// PostgreSQL + Prisma ORM
// Replaces legacy spreadsheets for ADI, BNB, DREAM, ECO, GREEN, KALAYAAN

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum ContractType {
  TRIAL
  M2M // Month-to-Month
  LONG_TERM
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

enum DocumentStatus {
  DRAFT_GENERATED
  GENERATION_FAILED
  PENDING_GENERATION
}

enum InspectionType {
  MOVE_IN
  MOVE_OUT
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// USER & TASK (Job/To-Do)
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // bcrypt hashed
  role      UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignedTasks     Task[]           @relation("AssignedTo")
  createdTasks      Task[]           @relation("CreatedBy")
  submittedPayments PaymentReceipt[] @relation("SubmittedPayments")
  reviewedPayments  PaymentReceipt[] @relation("ReviewedPayments")

  @@map("users")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  notes       String?    @db.Text

  // Relations
  assignedToId String
  assignedTo   User   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@map("tasks")
}

// ─────────────────────────────────────────────
// PROPERTY & UNIT
// ─────────────────────────────────────────────

model Property {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., ADI, BNB, DREAM, ECO, GREEN, KALAYAAN
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units Unit[]
  tasks Task[]

  @@map("properties")
}

model Unit {
  id          String     @id @default(cuid())
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitNumber  String
  monthlyRate Decimal    @db.Decimal(10, 2)
  status      UnitStatus @default(VACANT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  leases Lease[]
  tasks  Task[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([status])
  @@map("units")
}

// ─────────────────────────────────────────────
// TENANT & LEASE
// ─────────────────────────────────────────────

model Tenant {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  middleName        String?
  age               Int?
  gender            String? // Male/Female
  nationality       String?
  religion          String?
  civilStatus       String? // Single/Married etc
  mobileNumber      String
  email             String?  @unique
  fbMessenger       String?
  permanentAddress  String?  @db.Text
  recentAddress     String?  @db.Text
  // Employment
  company           String?
  companyPosition   String?
  workStatus        String? // REGULAR etc
  companyAddress    String?  @db.Text
  companyTel        String?
  companyEmail      String?
  companyMessenger  String?
  marketingSource   String? // How did you find out
  // IDs
  idType            String? // philhealth etc
  idNumber          String?
  idLink            String?  @db.Text // drive link
  dateIssued        DateTime? @db.Date
  emergencyContacts Json? // [{ name, phone, email, messenger }]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leases Lease[]

  @@index([email])
  @@map("tenants")
}

model Lease {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId              String
  unit                Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contractType        ContractType
  rentalStartDate     DateTime        @db.Date
  rentalEndDate       DateTime        @db.Date
  totalAmountToSettle Decimal         @db.Decimal(12, 2)
  status              LeaseStatus     @default(ACTIVE)
  // ── Reserve workflow / Document generation ──
  monthlyRent         Decimal?        @db.Decimal(10, 2)
  securityDeposit     Decimal?        @db.Decimal(10, 2)
  advanceDeposit      Decimal?        @db.Decimal(10, 2)
  addons              Json? // ReservationAddon[]
  addonsAmount        Decimal?        @db.Decimal(10, 2)
  noticePeriodDays    Int?
  leaseIntent         String? // New Lease | Renewal | Transfer | Hold
  leaseTerm           String? // Trial | M2M | 6 Months | 1 Year
  moveInDate          DateTime?       @db.Date
  rentDueDate         DateTime?       @db.Date // legacy DUE DATE string e.g. Every 6th
  dueDateText         String? // raw due date text
  documentLink        String?         @db.Text
  documentStatus      DocumentStatus?
  documentError       String?         @db.Text
  // ── Full contract fields (from spreadsheet 94 cols) ──
  controlNumber       String?         @unique
  barCode             String?
  propertyLoc         String? // e.g. ECO 888 at No.69 ...
  timeIn              String?
  currentDate         DateTime?       @db.Date // DATE: field
  terms               String? // TERMS: 1 year etc
  rate                Decimal?        @db.Decimal(10, 2) // RATE: duplicate of monthlyRent for legacy
  numPersons          Int?
  waterReading        Decimal?        @db.Decimal(10, 2)
  electricReading     Decimal?        @db.Decimal(10, 2)
  availFrom           DateTime?       @db.Date
  availTo             DateTime?       @db.Date
  items               String? // ITEM/S:
  dateSigned          DateTime?       @db.Date
  occupancySupportFee Decimal?        @db.Decimal(10, 2)
  propertyRep         String? // PROPERTY REPRESENTATIVE
  advance1Month       Decimal?        @db.Decimal(10, 2)
  deposit2Months      Decimal?        @db.Decimal(10, 2)
  day20               DateTime?       @db.Date
  penaltyDay          DateTime?       @db.Date
  contractStatus      String? // STATUS column
  emailStatus         String?
  signatureStatus     String?
  remarks             String?         @db.Text
  contactNumberAlt    String? // CONTACT NUMBER: separate from tenant mobile
  fbMessenger         String?
  permanentAddressAlt String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  inspections Inspection[]

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([rentalEndDate])
  @@index([documentStatus])
  @@index([controlNumber])
  @@map("leases")
}

// ─────────────────────────────────────────────
// INSPECTION (Move-in / Move-out Checklist)
// ─────────────────────────────────────────────

model Inspection {
  id              String         @id @default(cuid())
  leaseId         String
  lease           Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type            InspectionType @default(MOVE_IN)
  waterReading    Decimal?       @db.Decimal(10, 2)
  electricReading Decimal?       @db.Decimal(10, 2)
  // Granular handover checklist (YES/No + comments) — matches spreadsheet cols 46-71
  switches        String? // YES/No
  switchesCom     String? @db.Text
  sockets         String?
  socketsCom      String? @db.Text
  cabinet         String?
  cabinetCom      String? @db.Text
  lavatory        String?
  lavatoryCom     String? @db.Text
  lightBulb       String?
  lightBulbCom    String? @db.Text
  faucets         String?
  faucetsCom      String? @db.Text
  showerHead      String?
  showerHeadCom   String? @db.Text
  toiletFlush     String?
  toiletFlushCom  String? @db.Text
  toiletBowl      String?
  toiletBowlCom   String? @db.Text
  kitchenSink     String?
  kitchenSinkCom  String? @db.Text
  wallPaint       String?
  wallPaintCom    String? @db.Text
  optional        String?
  optionalCom     String? @db.Text
  windows         String?
  windowsCom      String? @db.Text
  checklistJson   Json? // fallback for any extra utilities/appliances
  remarks         String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([leaseId])
  @@map("inspections")
}

model PaymentReceipt {
  id           String        @id @default(cuid())
  tenantName   String
  property     String
  unit         String
  month        String // e.g., 2026-04
  amount       Decimal       @db.Decimal(10, 2)
  receiptUrl   String?       @db.Text // file path or data URL
  receiptName  String?
  status       PaymentStatus @default(PENDING)
  submittedById String?
  submittedBy  User?         @relation("SubmittedPayments", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?         @relation("ReviewedPayments", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([property])
  @@index([month])
  @@map("payment_receipts")
}
